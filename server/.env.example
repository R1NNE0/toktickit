# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5433/toktickit?schema=public"
PORT=3000
# Explicit development-only HTTP mode; use false with HTTPS.
FRONTEND_ORIGIN=http://localhost:5173
AUTH_ALLOW_HTTP_LOCALHOST=true
# Upgrade existing data from a private interactive terminal:
# npm run prisma:migrate:auth (set DATABASE_URL explicitly first)
# Then npm run prisma:seed; both display only newly provisioned passwords once.
