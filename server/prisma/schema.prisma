// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 2 Enums
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Lab 2 Models
// ---------------------------------------------------------------------------

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionRevisionOperation {
  CREATE
  EDIT
  REASSIGN
  START
  COMPLETE
  CANCEL
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emailNormalized String @unique
  role UserRole @default(REQUESTER)
  passwordHash String
  mustChangePassword Boolean @default(true)
  passwordChangedAt DateTime?

  tickets Ticket[] @relation("TicketRequester")
  ownedTickets Ticket[] @relation("TicketOwner")
  resolutionSuggestedTickets Ticket[] @relation("TicketResolutionSuggestedBy")
  publicComments PublicComment[] @relation("PublicCommentAuthor")
  internalNotes InternalNote[] @relation("InternalNoteAuthor")
  sessions Session[]
  createdActionsTaken ActionTaken[] @relation("ActionTakenCreator")
  assignedActionsTaken ActionTaken[] @relation("ActionTakenAssignee")
  performedActionsTaken ActionTaken[] @relation("ActionTakenPerformer")
  actionTakenRevisions ActionTakenRevision[] @relation("ActionTakenRevisionActor")

  @@map("RequesterUser")
}

model Session {
  tokenHash String @id
  userId Int?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  createdAt DateTime @default(now())
  lastSeenAt DateTime
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique
  summary           String
  description       String       @db.Text
  requestedPriority Priority     @default(MEDIUM)
  itPriority        Priority     @default(MEDIUM)
  currentStatus     TicketStatus @default(NEW)

  requesterId     Int
  requester       User @relation("TicketRequester", fields: [requesterId], references: [id])
  ownerId         Int?
  owner           User? @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  idempotencyKey String?

  resolutionSuggestedAt   DateTime?
  resolutionSuggestedById Int?
  resolutionSuggestedBy   User?     @relation("TicketResolutionSuggestedBy", fields: [resolutionSuggestedById], references: [id], onDelete: SetNull)

  attachments Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actionsTaken ActionTaken[] @relation("TicketActionsTaken")

  workflowVersion Int @default(1)
  workCycle Int @default(1)
  resolvedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, idempotencyKey])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([requesterId, currentStatus])
  @@index([ownerId, currentStatus])
  @@index([currentStatus, itPriority])
  @@index([updatedAt, id])
  @@index([requesterId, updatedAt, id])
  @@index([requesterId, resolvedAt, id])
}

// SQL CHECK constraints live in the additive Lab 4 migration.
model ActionTaken {
  id Int @id @default(autoincrement())
  ticketId Int
  ticket Ticket @relation("TicketActionsTaken", fields: [ticketId], references: [id], onDelete: Restrict)
  cycle Int
  status ActionStatus @default(PLANNED)
  description String @db.Text
  result String? @db.Text
  assigneeId Int
  assignee User @relation("ActionTakenAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById Int
  createdBy User @relation("ActionTakenCreator", fields: [createdById], references: [id], onDelete: Restrict)
  performedById Int?
  performedBy User? @relation("ActionTakenPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  followUpRequired Boolean @default(false)
  followUpNote String? @db.Text
  attachmentNotes String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancellationReason String? @db.Text
  version Int @default(1)
  clientRequestId String @db.Uuid
  createRequestHash String @db.Char(64)
  revisions ActionTakenRevision[] @relation("ActionTakenRevisions")

  @@unique([createdById, clientRequestId])
  @@index([ticketId, cycle, createdAt, id])
  @@index([ticketId, cycle, status])
  @@index([assigneeId, status, ticketId])
}

// Append-only application history; restrictive FKs preserve referenced identities.
model ActionTakenRevision {
  id Int @id @default(autoincrement())
  actionId Int
  action ActionTaken @relation("ActionTakenRevisions", fields: [actionId], references: [id], onDelete: Restrict)
  version Int
  operation ActionRevisionOperation
  actorId Int
  actor User @relation("ActionTakenRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  changeReason String? @db.Text
  snapshot Json

  @@unique([actionId, version])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName      String
  storedPath    String
  fileSize      Int
  mimeType      String
  isRemoved     Boolean   @default(false)
  removedAt     DateTime?
  removalReason String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([ticketId])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("PublicCommentAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("InternalNoteAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt, id])
}
